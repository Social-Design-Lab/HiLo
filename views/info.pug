extends ui_layout

block styles 
  link(type='text/css', rel='stylesheet', href='/public/css/info.css')

block content
  .ui.text.container(style="margin-top: 2em; margin-bottom: 2em;")
    img.ui.centered.fluid.image(src='/public/HiLo%20Instructions%20Page%20v2.png', alt='HiLo instructions')
    .ui.big.green.button.interest
        img#logo(src=process.env.SITE_LOGO)
        span Continue
    //- .ui.big.green.labeled.icon.button.interest
    //-     //- i.rocket.icon
    //-     img.ui.tiny.image(src=process.env.SITE_LOGO, id='logo')
    //-     //- i.ui.tiny.icon(src=process.env.SITE_LOGO, id='logo')
    //-     |   Continue

    script.
        $('.ui.button.interest').on('click', function() {
        //- $('.ui.big.green.labeled.icon.button.interest').on('click', function() {
            $(this).addClass('loading disabled');
            $.post("/account/consent", {
                    _csrf: $('meta[name="csrf-token"]').attr('content')
                }).done(function(json) {
                    if (json["result"] === "success") {
                        window.location.href = '/'
                    }
                });
        });
